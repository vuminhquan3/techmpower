rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Bootstrapped admin check + email-based database check
      return isSignedIn() && (
        request.auth.token.email == 'kenvuofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    function isValidId(id) {
       // Allow dots for emails used as IDs
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidDonation(data) {
      return data.amount is number && data.amount > 0 &&
             data.donorName is string && data.donorName.size() <= 100 &&
             data.timestamp == request.time &&
             data.keys().hasAll(['amount', 'donorName', 'timestamp']) &&
             data.keys().size() >= 3 && data.keys().size() <= 4;
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.date is string &&
             data.location is string &&
             data.type is string &&
             (data.featured == null || data.featured is bool) &&
             (data.image == null || data.image is string);
    }

    // --- Rules ---

    match /admins/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      // Public can read donation history, but we should restrict list queries to reasonable amounts
      allow read: if true; 
      // Anyone can create a donation entry (simplification for the demo/donation flow)
      // In production, this might be handled by a cloud function after payment confirmation
      allow create: if isValidId(donationId) && isValidDonation(incoming());
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(eventId) && isValidEvent(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
